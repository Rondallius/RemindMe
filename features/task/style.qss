/* style.qss - the colours of the program. */

QWidget {
    background-color: #f4f7fb;
    color: #1f2937;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 14px;
}

#mainContent {
    background-color: #f4f7fb;
}

#appHeader {
    background-color: #1769aa;
    border: none;
    border-radius: 10px;
}

#appTitle {
    background: transparent;
    color: #ffffff;
    font-size: 19px;
    font-weight: 700;
}

#appSubtitle {
    background: transparent;
    color: #d6e6f7;
    font-size: 12px;
}

QLabel {
    background: transparent;
    color: #334155;
    font-weight: 600;
}

#infoLabel {
    background-color: #ffffff;
    border: 1px solid #d5deea;
    border-radius: 6px;
    color: #3b4a5e;
    font-weight: 400;
    padding: 6px 10px;
}

QPushButton {
    background-color: #2563eb;
    border: none;
    border-radius: 6px;
    color: #ffffff;
    font-weight: 600;
    min-height: 28px;
    padding: 7px 14px;
}

QPushButton:hover {
    background-color: #1d4ed8;
}

QPushButton:pressed {
    background-color: #1e40af;
}

QPushButton:disabled {
    background-color: #a9bcda;
    color: #eff3f9;
}

QLineEdit,
QTextEdit {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    color: #1f2937;
    padding: 6px 8px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QLineEdit:focus,
QTextEdit:focus {
    border: 2px solid #3b82f6;
    padding: 5px 7px;
}

QTableWidget {
    outline: 0;
    background-color: #ffffff;
    alternate-background-color: #f6f9fd;
    border: 1px solid #d5deea;
    border-radius: 6px;
    gridline-color: #e6ecf5;
    selection-background-color: #dbeafe;
    selection-color: #17457a;
}

QTableWidget::item {
    padding: 6px 8px;
}

QTableWidget::item:selected {
    background-color: #dbeafe;
    color: #17457a;
}

QTableWidget::item:selected:active {
    background-color: #2f6fdb;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #eaf2fb;
    border: none;
    border-bottom: 1px solid #d5deea;
    color: #334155;
    font-weight: 700;
    padding: 8px;
}

QTableCornerButton::section {
    background-color: #eaf2fb;
    border: none;
}

QDialog,
QMessageBox {
    background-color: #ffffff;
}

QMessageBox QLabel {
    color: #1f2937;
    font-weight: 400;
}

QStatusBar {
    background-color: #eaf1f9;
    border-top: 1px solid #d5deea;
    color: #41526b;
}
